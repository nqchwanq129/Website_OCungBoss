#!/bin/sh
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in *[!0]*) ;; *) continue ;; esac
  commits=$(git rev-list --full-history "$local_oid" -- ':(top,icase)docs' ':(top,icase)design') || exit 1
  if [ -n "$commits" ]; then
    echo 'Blocked: pushed history contains docs/ or design/.' >&2
    exit 1
  fi
done
